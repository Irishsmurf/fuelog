{
  "name": "fuelog-functions",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "rm -rf lib && tsc && cp -r src/templates lib/functions/src/templates",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "recompress-receipts": "npm run build && node lib/functions/src/scripts/recompressReceipts.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild-station-stats": "npm run build && node lib/functions/src/scripts/rebuildStationStats.js",
    "derived-log-fields": "npm run build && node lib/functions/src/scripts/derivedLogFields.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
