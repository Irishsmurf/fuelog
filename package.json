{
  "name": "fuelog",
  "private": true,
  "version": "2.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "preview": "vite preview",
    "validate-env": "node scripts/validate-env.js",
    "prepare": "husky",
    "test:rules": "npx -y firebase-tools@14.27.0 emulators:exec --only firestore --project demo-fuelog-rules 'vitest run --config vitest.rules.config.ts'",
    "test:e2e:emulators": "npx -y firebase-tools@14.27.0 emulators:exec --only auth,firestore --project demo-fuelog 'playwright test --project=chromium --grep @e2e'"
  },
  "dependencies": {
    "@fuelog/core": "0.1.0",
    "@google/genai": "^2.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@sentry/react": "^10.42.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.3.1",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "i18next": "^27.1.3",
    "i18next-browser-languagedetector": "^8.3.0",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-helmet-async": "^3.1.0",
    "react-i18next": "^16.5.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.0",
    "recharts": "^2.15.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "uuid": "^11.1.1",
    "jose": "~5.10.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^9.21.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.4.27",
    "concurrently": "^10.0.3",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
