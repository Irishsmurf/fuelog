rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: the document belongs to the requesting user
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: the existing doc belongs to the caller and an update keeps it that
    // way. Without the second check a user could re-assign their own document
    // (or API token) to another uid.
    function ownsAndKeepsOwnership() {
      return isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Helper: an optional field is either absent or of the expected type.
    function optNumber(d, k) { return d.get(k, 0) is number; }
    function optString(d, k) { return d.get(k, '') is string; }

    // Shape checks applied to every write of a fuel log (create and update).
    // Optional fields are type-checked only when present so legacy documents
    // remain editable.
    function validLogFields(d) {
      return d.userId is string
        && optNumber(d, 'cost')
        && optNumber(d, 'distanceKm')
        && optNumber(d, 'fuelAmountLiters')
        && optNumber(d, 'odometerKm')
        && optNumber(d, 'originalCost')
        && optNumber(d, 'exchangeRate')
        && optNumber(d, 'latitude')
        && optNumber(d, 'longitude')
        && optNumber(d, 'locationAccuracy')
        && optString(d, 'vehicleId')
        && optString(d, 'stationId')
        && optString(d, 'brand')
        && optString(d, 'currency')
        && optString(d, 'receiptUrl')
        && (!d.keys().hasAny(['source']) || d.source in ['app', 'import', 'api', 'mcp'])
        && optNumber(d, 'schemaVersion')
        && (!d.keys().hasAny(['fillType']) || d.fillType in ['full', 'partial'])
        && (!d.keys().hasAny(['missedPrevious']) || d.missedPrevious is bool)
        && (!d.keys().hasAny(['timestamp']) || d.timestamp is timestamp);
    }

    // Fuel logs: users can only read/write their own entries
    match /fuelLogs/{logId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if ownsAndKeepsOwnership()
        && validLogFields(request.resource.data);
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && validLogFields(request.resource.data)
        && request.resource.data.cost is number
        && request.resource.data.distanceKm is number
        && request.resource.data.fuelAmountLiters is number
        && request.resource.data.timestamp is timestamp;
    }

    // Vehicles: users can only read/write their own vehicles
    match /vehicles/{vehicleId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if ownsAndKeepsOwnership();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
    }

    // User profiles: each user owns their own profile document (doc ID == uid)
    match /userProfiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    // API tokens: users can manage their own tokens.
    // Only the SHA-256 hash is stored — the raw token never touches Firestore.
    // Tokens are immutable once created; the only client-side change allowed is
    // revoking (isRevoked: true). lastUsedAt is written by the server via the
    // Admin SDK, which bypasses these rules.
    match /apiTokens/{tokenId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRevoked'])
        && request.resource.data.isRevoked == true;
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.isRevoked == false
        && request.resource.data.tokenHash is string
        && request.resource.data.tokenHash.size() == 64  // SHA-256 hex = 64 chars
        && request.resource.data.scopes is list
        && request.resource.data.scopes.hasOnly(['read:logs', 'write:logs', 'read:vehicles', 'write:vehicles'])
        && (request.resource.data.get('expiresAt', null) == null
            || request.resource.data.expiresAt is timestamp);
    }

    // Stations: global collection of petrol stations, shared by all users.
    // Clients may create a station (with zeroed legacy stats) when they first
    // link a fill-up to it. All statistics are maintained server-side by the
    // updateStationStats Cloud Function (Admin SDK), so clients can't update.
    match /stations/{stationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.osmId is string
        && request.resource.data.name is string
        && request.resource.data.logCount == 0
        && request.resource.data.avgPrice == 0
        && !request.resource.data.keys().hasAny(['lastPrice', 'priceStats']);
      allow update: if false;
    }

    // FCM tokens: users can only read/write their own push notification tokens.
    // Document ID is the FCM registration token itself.
    match /fcmTokens/{tokenId} {
      allow read, delete: if isAuthenticated()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.token is string
        && request.resource.data.platform == 'web';
    }

    // Budget alert idempotency tracking: written only by the checkBudgetAlert
    // Cloud Function via the Admin SDK (which bypasses these rules). No client
    // access needed or allowed.
    match /budgetAlerts/{alertId} {
      allow read, write: if false;
    }

    // Audit trail for the sendTestNotification dev tool: written only by
    // that Cloud Function via the Admin SDK (which bypasses these rules).
    // No client access needed or allowed.
    match /testNotifications/{notificationId} {
      allow read, write: if false;
    }

    // Per-user rate-limit counters (e.g. receipt scans), written only by the
    // API via the Admin SDK. Clients must not be able to reset their quota.
    match /usageQuotas/{quotaId} {
      allow read, write: if false;
    }
  }
}
